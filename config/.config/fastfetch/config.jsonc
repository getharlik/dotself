{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
"type": "auto",
"source": "",
"color": {
"1": "",
"2": "",
"3": "",
"4": "",
"5": "",
"6": "",
"7": "",
"8": "",
"9": ""
},
"width": null,
"height": null,
"padding": {
"top": 0,
"left": 0,
"right": 4
},
"printRemaining": true,
"preserveAspectRatio": false,
"recache": false,
"position": "left",
"chafa": {
"fgOnly": false,
"symbols": "block+border+space-wide-inverted"
}
},
"display": {
"separator": " : ",
},
"modules": [
{
"type": "custom",
"format": "┌────────────────────────────────────────────────┐",
},
{
"type": "os",
"key": "  󰣇 OS",
"format": "{2}",
"keyColor": "red",
},
{
"type": "kernel",
"key": "   Kernel",
"format": "{2}",
"keyColor": "red",
},
{
"type": "packages",
"key": "  󰏗 Packages",
"keyColor": "green",
},
{
"type": "display",
"key": "  󰍹 Display",
"format": "{1}x{2} @ {3}Hz [{7}]",
"keyColor": "green",
},
{
"type": "terminal",
"key": "   Terminal",
"keyColor": "yellow",
},
{
"type": "wm",
"key": "  󱗃 WM",
"format": "{2}",
"keyColor": "yellow",
},
{
"type": "custom",
"format": "└────────────────────────────────────────────────┘",
},
"break",
{
"type": "title",
"key": "  ",
"keyColor": "yellow",
"format": "{6} {7} {8}",
},
{
"type": "custom",
"format": "┌────────────────────────────────────────────────┐",
},
{
"type": "cpu",
"format": "{1}",
"key": "   CPU",
"keyColor": "blue",
},
{
"type": "gpu",
"format": "{1} {2}",
"key": "  󰊴 GPU",
"keyColor": "blue",
},
{
"type": "memory",
"key": "  💾Memory ",
"keyColor": "red",
},
{
"type": "command",
"key": "  󱦟 OS Age ",
"keyColor": "red",
"text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
},
{
"type": "uptime",
"key": "  󱫐 Uptime ",
"keyColor": "red",
},
{
"type": "custom",
"format": "└────────────────────────────────────────────────┘",
},
{
"type": "colors",
"paddingLeft": 2,
"symbol": "circle",
},
"break",
],
}